# Ignore everything by default
*

# ── Workspace config ──────────────────────────────
!*.code-workspace

# ── Dev container ─────────────────────────────────
!.devcontainer/
!.devcontainer/**

# Claude Code shared skills & config
!.claude/
!.claude/**

# But never commit local machine-specific permissions
.claude/settings.local.json

# ── Documentation ─────────────────────────────────
!docs/
!docs/**

# ── This file ─────────────────────────────────────
!.gitignore

.claude/.DS_Store
docs/**/.DS_Store