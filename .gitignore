# Ignore everything by default
*

# ── Workspace config ──────────────────────────────
!*.code-workspace

# ── Dev container ─────────────────────────────────
!.devcontainer/
!.devcontainer/**

# Claude Code shared skills & config
!CLAUDE.md
!.claude/
!.claude/**

# But never commit local machine-specific permissions
.claude/settings.local.json

# ── Documentation ─────────────────────────────────
!docs/
!docs/**

# ── Repo packing for external AI tools ────────────
# !bin/ only lets git descend into bin/; the top-level * still matches
# bin/dev, so the foreman launcher stays untracked.
!bin/
!bin/repomix-pack

# ── This file ─────────────────────────────────────
!.gitignore

.claude/.DS_Store
docs/**/.DS_Store

# ── repomix packs — regenerated on demand, never committed ──
# Already covered by the leading *, stated explicitly so a future ! line
# cannot expose them. Last matching pattern wins, so this stays last.
/repomix-out/