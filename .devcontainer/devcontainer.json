{
  "name": "insgt-platform",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/startup.sh",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind",
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent",
    "SITE_DATA_PATH": "/host-data/site-data.json"
  },
  "forwardPorts": [
    3000,
    3001,
    3002,
    4200,
    4300,
    4400,
    4500,
    8080
  ],
  "portsAttributes": {
    "3000": {
      "label": "insgt-api",
      "onAutoForward": "silent"
    },
    "3001": {
      "label": "insgt-galleries",
      "onAutoForward": "silent"
    },
    "3002": {
      "label": "insgt-virtual-tour",
      "onAutoForward": "silent"
    },
    "4200": {
      "label": "insgt-app",
      "onAutoForward": "silent"
    },
    "4300": {
      "label": "insgt-ops",
      "onAutoForward": "silent"
    },
    "4400": {
      "label": "insgt-photographers",
      "onAutoForward": "silent"
    },
    "4500": {
      "label": "insgt-disclosure-gallery",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "insgt-site-sls",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "Anthropic.claude-code",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "args": ["-l"]
          }
        }
      }
    }
  }
}